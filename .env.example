# Строка подключения к базе PostgreSQL (Neon).
# Формат: postgresql://ПОЛЬЗОВАТЕЛЬ:ПАРОЛЬ@ХОСТ/ИМЯ_БАЗЫ?sslmode=require
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Пароль для входа в админ-панель (/admin)
ADMIN_PASSWORD="admin123"

# Секрет для подписи cookie сессии администратора.
# В продакшене замените на длинную случайную строку (например: openssl rand -base64 32).
AUTH_SECRET="change-me-to-a-random-string"
