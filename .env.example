# Строка подключения к базе. Локально — файловый SQLite:
DATABASE_URL="file:./dev.db"

# Пароль для входа в админ-панель (/admin)
ADMIN_PASSWORD="admin123"

# Секрет для подписи cookie сессии администратора.
# В продакшене замените на длинную случайную строку.
AUTH_SECRET="change-me-to-a-random-string"
